# URL da API consumida pelo front. Copie para .env.local em desenvolvimento e defina na Vercel em produção.
# É embutida no build: alterar exige um novo deploy.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Chave pública do gateway para tokenização de cartão no navegador (nunca use secret key no front)
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=
NEXT_PUBLIC_PAGARME_API_BASE_URL=https://sdx-api.pagar.me/core/v5
# Opcional: endpoint customizado para tokenização em ambiente de homologação controlado
NEXT_PUBLIC_PAYMENT_TOKENIZATION_URL=
