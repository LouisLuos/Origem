{
  "name": "origem-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "worker:start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "notificacoes:previews": "tsx scripts/gerar-previews-notificacoes.ts",
    "integracoes:check": "tsx scripts/verificar-integracoes.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "storage:setup": "tsx scripts/setup-storage.ts",
    "prisma:deploy": "prisma migrate deploy",
    "test:integration": "RUN_DB_INTEGRATION=1 node --import tsx --test tests/integracao/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.7.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "ioredis": "^6.0.0",
    "jose": "^6.0.11",
    "nodemailer": "^10.6.1",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.16.0",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
