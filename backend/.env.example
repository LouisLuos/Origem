# Conexão principal PostgreSQL (Local ou Supabase Session Pooler / Direct)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/origem?schema=public"

# Porta do servidor HTTP (Fase 3 - Express)
PORT=3000

