# Copie para backend/.env e preencha. NUNCA versione o .env real.

# PostgreSQL (Supabase). DATABASE_URL: pooler de transação; DIRECT_URL: pooler de sessão (migrations)
DATABASE_URL=
DIRECT_URL=

# Sessão JWT (obrigatório e forte em produção: 32+ caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Chave AES-256 (64 hex) que cifra a Chave Pix do artesão. Deve ser a MESMA em todos os
# backends que usam o mesmo banco. Gere com: openssl rand -hex 32
PIX_ENCRYPTION_KEY=

# Armazenamento das fotos das peças
#  - local: grava em backend/uploads/fotos-pecas e serve em /uploads/fotos-pecas (desenvolvimento)
#  - supabase: usa o Supabase Storage (requer as chaves abaixo e `npm run storage:setup`)
FOTOS_STORAGE_DRIVER=local
FOTOS_PUBLIC_BASE_URL=http://localhost:3001
# FOTOS_STORAGE_LOCAL_DIR=

# Supabase Storage — a service_role é SECRETA e fica somente no backend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_FOTOS=fotos-pecas

# URL pública do frontend (links de acompanhamento em notificações)
APP_PUBLIC_URL=http://localhost:5173

# Redis e BullMQ — Hub de Notificações Assíncronas (HU-17)
# Informe REDIS_URL ou utilize REDIS_HOST/REDIS_PORT
# REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=origem
NOTIFICATION_QUEUE_NAME=origem-notificacoes
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_BACKOFF_INITIAL_MS=1000
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_PROVIDER_TIMEOUT_MS=8000
NOTIFICATION_SLA_CHECK_INTERVAL_MS=3600000
# Feriados oficiais em formato ISO separados por vírgula (ex.: 2026-12-25,2027-01-01)
NOTIFICATION_HOLIDAYS_ISO=

# E-mail transacional (disabled | smtp | http_webhook)
EMAIL_PROVIDER=disabled
EMAIL_FROM="Origem Marketplace <nao-responda@origem.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_HTTP_ENDPOINT=
EMAIL_HTTP_API_KEY=

# WhatsApp oficial — Meta Cloud API ou gateway HTTP autorizado (disabled | meta_cloud | http_webhook)
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_LANGUAGE=pt_BR
WHATSAPP_HTTP_ENDPOINT=
WHATSAPP_HTTP_API_KEY=

# Checkout, Pagamentos e Webhooks (HU-10)
# Gateway: disabled | pagarme_v5 | mercado_pago | http_sandbox
PAYMENT_GATEWAY=disabled
# Ambiente: sandbox | production
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_GATEWAY_TIMEOUT_MS=10000

# Pagar.me Core v5 (sandbox: https://sdx-api.pagar.me/core/v5 | producao: https://api.pagar.me/core/v5)
PAGARME_API_BASE_URL=https://sdx-api.pagar.me/core/v5
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
PAGARME_WEBHOOK_SECRET=
PAGARME_WEBHOOK_BASIC_USER=
PAGARME_WEBHOOK_BASIC_PASS=

# Mercado Pago (opcional, adaptador secundário)
MP_API_BASE_URL=https://api.mercadopago.com
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Provedor HTTP controlado (somente homologacao/testes automatizados)
PAYMENT_HTTP_ENDPOINT=
PAYMENT_HTTP_API_KEY=
PAYMENT_HTTP_WEBHOOK_SECRET=

# Cotação de frete multi-origem (ADR-001 / HU-10): disabled | http_webhook
FRETE_PROVIDER=disabled
FRETE_HTTP_ENDPOINT=
FRETE_HTTP_API_KEY=
FRETE_TIMEOUT_MS=5000

# Outbox Relay no Worker (HU-10 + HU-17)
OUTBOX_RELAY_INTERVAL_MS=5000
