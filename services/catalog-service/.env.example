# Configuração local do Catalog Service (sem credenciais)
PORT=3001
USE_POSTGRES=true
RECOMMENDATION_SERVICE_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Opcional: leitura somente-leitura do PostgreSQL/Supabase compartilhado.
# Se ausentes ou indisponíveis, o serviço opera normalmente com data/catalogo.json.
DATABASE_URL=
DIRECT_URL=
